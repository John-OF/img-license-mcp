# ---------------------------------------------------------------------------
# Img-License MCP - environment variables
# Copy this file to `.env` and fill in only what you use.
# Keyless sources (Commons, Openverse) always work; the others are skipped
# cleanly when their key is missing.
# ---------------------------------------------------------------------------

# --- HTTP client identity ---------------------------------------------------
# Wikimedia answers 403 to generic User-Agents. Use a descriptive one with a
# real contact (a URL or an email). Left empty, the server's default is used.
IMG_LICENSE_USER_AGENT=MyBlog-ImgLicense/1.0 (https://example.com; contact@example.com)

# --- Optional sources (free API key) ----------------------------------------
# Unsplash - https://unsplash.com/oauth/applications  (Access Key, not the Secret)
UNSPLASH_ACCESS_KEY=

# Pexels - https://www.pexels.com/api/new/
PEXELS_API_KEY=

# Pixabay - https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# National Park Service - https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=

# --- WordPress (only for upload_to_wordpress) -------------------------------
# Create the Application Password under Users > Profile > Application Passwords.
# Paste it WITH its spaces, exactly as WordPress shows it.
WP_BASE_URL=https://example.com
WP_USER=
WP_APP_PASSWORD=
